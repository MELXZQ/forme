# Run npm run db:setup to generate private local credentials in .env.local.
DATABASE_URL=postgresql://forme_app:REPLACE_LOCALLY@127.0.0.1:55432/forme_dev
DIRECT_URL=postgresql://forme_migrator:REPLACE_LOCALLY@127.0.0.1:55432/forme_dev
SHADOW_DATABASE_URL=postgresql://forme_migrator:REPLACE_LOCALLY@127.0.0.1:55432/forme_shadow
BETTER_AUTH_SECRET=GENERATE_A_RANDOM_SECRET
BETTER_AUTH_URL=http://127.0.0.1:3000
STORAGE_DIR=.local/uploads
POSTGRES_BIN=/opt/homebrew/opt/postgresql@17/bin
ENABLE_OPERATIONS=true
# Owner-only simulation; always rejected in production, even when true.
ENABLE_DEV_PAYMENTS=false
