{
  "name": "forme-jewellery",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "assets": "node scripts/generate-assets.mjs",
    "format": "prettier --write .",
    "verify:routes": "node --import tsx scripts/check-routes.ts"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.5",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "prettier": "^3.6.0"
  }
}
